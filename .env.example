# Backend API base URL (no trailing slash)
# Production: https://autodrive-backend-production.up.railway.app
# Local dev:  http://localhost:3000
VITE_API_BASE_URL="https://autodrive-backend-production.up.railway.app"

# Umami analytics — both vars required; either missing → full no-op
# Quickstart: https://cloud.umami.is → Add website → copy Script URL + Website ID
VITE_UMAMI_SRC="https://cloud.umami.is/script.js"
VITE_UMAMI_WEBSITE_ID=""
