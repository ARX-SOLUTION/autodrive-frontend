# Backend API base URL (no trailing slash)
# Production: https://api.automaktab.uz
# Local dev:  http://localhost:3000
VITE_API_BASE_URL="https://api.automaktab.uz"
VITE_STUDENT_PORTAL_URL="https://student.automaktab.uz"

# Fleet map: development uses OSM's public tiles when these are unset.
# Production has no public-server fallback: set a licensed or self-hosted
# OSM-derived raster tile URL and any additional provider attribution.
# VITE_ values are public in the browser; do not put secret keys here.
VITE_FLEET_MAP_TILE_URL=""
VITE_FLEET_MAP_TILE_ATTRIBUTION=""

# Authenticated OpenAPI contract used by pnpm run api:types/api:check.
# These are Node-only variables and must never use the VITE_ prefix.
OPENAPI_URL="https://api.automaktab.uz/api/openapi.json"
OPENAPI_USERNAME="adminAutodrive0222"
OPENAPI_PASSWORD=""
# Alternatively, use OPENAPI_TOKEN for a CI-provided Bearer token.
OPENAPI_TOKEN=""

# Umami analytics — both vars required; either missing → full no-op
# Quickstart: https://cloud.umami.is → Add website → copy Script URL + Website ID
VITE_UMAMI_SRC="https://cloud.umami.is/script.js"
VITE_UMAMI_WEBSITE_ID=""

# Sales demo one-click sign-in. Both are required; otherwise /login only
# prefills demo@automaktab.uz. VITE_ values are public in the browser bundle —
# set them on the production Vercel project only, never in source.
# VITE_ENABLE_DEMO_LOGIN="true"
# VITE_DEMO_PASSWORD=""
